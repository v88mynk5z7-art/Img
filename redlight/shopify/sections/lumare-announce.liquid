{%- render 'lumare-assets' -%}
<div class="lumare-scope lumare-announce" role="region" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="lumare-announce__track" data-lumare-announce>
    {%- for block in section.blocks -%}
      <p class="{% if forloop.first %}lumare-is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} .lumare-announce { background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; }
  #shopify-section-{{ section.id }} .lumare-announce a { color: inherit; text-decoration: none; }
</style>
{% schema %}
{
  "name": "Lumaré · Offer bar",
  "tag": "div",
  "class": "lumare-section-announce",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessibility label", "default": "Offers" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#6e0c10" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#f7d9cf" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free express shipping on every order" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Lumaré · Offer bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free express shipping on every order" } },
        { "type": "message", "settings": { "text": "60-night risk-free trial · Love it or return it" } },
        { "type": "message", "settings": { "text": "2-year warranty · UK-based customer care" } }
      ]
    }
  ]
}
{% endschema %}
