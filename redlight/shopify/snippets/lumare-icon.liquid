  {%- when 'drop' -%}<svg class="lumare-tile__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M16 4c5 6 8 10 8 14a8 8 0 0 1-16 0c0-4 3-8 8-14Z"/></svg>
