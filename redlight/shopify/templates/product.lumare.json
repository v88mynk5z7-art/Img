    "faq": {
      "type": "lumare-faq",
      "settings": {},
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "Is red light therapy safe?",
            "answer": "<p>Lumaré Duo uses low-level 650nm LEDs — no UV and no lasers. The tips stay comfortable to the touch and the device switches off automatically after ten minutes. Please read the safety guidance before use, and speak to your doctor if you have a medical condition, are pregnant or are photosensitive.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "How do I use it for my nose and for my ears?",
            "answer": "<p>For the nose ritual, rest the soft tips gently at the entrance of each nostril. For the ear ritual, place them lightly at the outer ear. In both cases the tips should rest, never be pushed in. Press once to start, and relax for ten minutes.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "How often should I use it?",
            "answer": "<p>Most people enjoy one or two ten-minute sessions a day. Consistency matters more than duration — think of it like brushing your teeth.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "When will I notice a difference?",
            "answer": "<p>Everyone is different. We recommend making Lumaré a daily habit for at least four weeks — which is exactly why you get a full sixty nights to try it risk-free.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Can I share it with my partner?",
            "answer": "<p>For hygiene, we recommend one device per person. That's why our two-device bundle is the most popular choice for couples and families — and it saves you money too.</p>"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "How do I clean and charge it?",
            "answer": "<p>Wipe the silicone tips with a clean, damp cloth or an alcohol-free wipe after every use. Charge with the included USB-C cable; one full charge lasts for many sessions.</p>"
          }
        },
        "q_7": {
          "type": "question",
          "settings": {
            "question": "Is Lumaré a medical device?",
            "answer": "<p>No. Lumaré Duo is a personal wellness device. It is not intended to diagnose, treat, cure or prevent any disease, and it is not a substitute for medical advice.</p>"
          }
        },
        "q_8": {
          "type": "question",
          "settings": {
            "question": "What about shipping and returns?",
            "answer": "<p>Every order ships free by tracked express delivery. If you're not completely happy within sixty nights, contact us for a full refund.</p>"
          }
        }
